<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Detalhe da Tarefa</title>
</head>
<body>

  <h1><%= tarefa.titulo %></h1>

  <p><strong>ID:</strong> <%= tarefa.id %></p>
  <p><strong>Descrição:</strong> <%= tarefa.descricao || "Sem descrição." %></p>
  <p><strong>Prioridade:</strong> <%= tarefa.prioridade %></p>
  <p><strong>Status:</strong> <%= tarefa.concluida ? "Concluída" : "Pendente" %></p>
  <p><strong>Data de Criação:</strong> <%= new Date(tarefa.dataCriacao).toLocaleDateString("pt-BR") %></p>

  <br>

  <a href="/pagina/tarefas">← Voltar</a>

  <% if (!tarefa.concluida) { %>
    <form method="POST" action="/pagina/tarefas/<%= tarefa.id %>/concluir">
      <button type="submit">Marcar como Concluída</button>
    </form>
  <% } %>

  <form method="POST" action="/pagina/tarefas/<%= tarefa.id %>/excluir">
    <button type="submit">Excluir</button>
  </form>

</body>
</html>